# Copy to .env (git-ignored). Names only, never commit values.
# Values unquoted and without "$": the Makefile includes this file (make does not strip quotes).
CONTEXT_DEV_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=
# gemini-2.5-flash is no longer available to new accounts; use gemini-3.8-flash
GEMINI_LLM_MODEL=gemini-3.8-flash
# Oxylabs Web API (/search + /scrape). Cancel the $500 Flexible plan after the hackathon.
OXYLABS_WEB_API_KEY=
HOSTINGER_AI_ROUTER_KEY=
HOSTINGER_AI_ROUTER_BASE_URL=
HOSTINGER_AI_ROUTER_MODEL=
# Hostinger VPS public IP (KVM 2, Ubuntu 24.04 + Docker)
VPS_HOST=
DOMAIN=
POSTGRES_USER=ltr
POSTGRES_PASSWORD=
POSTGRES_DB=ltr
DATABASE_URL=
TOPICS=
POLL_INTERVAL_SEC=180
DETECT_WINDOW_HOURS=6
# salt for pseudonymizing real account handles in committed files (live samples, labels)
LTR_HASH_SALT=
# "gemini" in prod, "hash" in tests (offline)
LTR_EMBEDDER=gemini
