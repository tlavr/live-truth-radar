# Copy to .env (git-ignored). Names only, never commit values.
# Values unquoted and without "$": the Makefile includes this file (make does not strip quotes).
CONTEXT_DEV_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=
GEMINI_LLM_MODEL=
HOSTINGER_AI_ROUTER_KEY=
HOSTINGER_AI_ROUTER_BASE_URL=
HOSTINGER_AI_ROUTER_MODEL=
DOMAIN=
POSTGRES_USER=ltr
POSTGRES_PASSWORD=
POSTGRES_DB=ltr
DATABASE_URL=
# comma-separated slugs; Context.dev query + keyword gate per slug: TOPIC_SPECS in ingest/contextdev.py
TOPICS=
POLL_INTERVAL_SEC=300
# T12d: frequent detector frames for open scan sessions and running attacks (seconds)
SCAN_INTERVAL_SEC=10
# 1 = also poll reddit-search via Context.dev (off: it fails with WEBSITE_ACCESS_ERROR and halves the 10 req/min budget)
REDDIT_ENABLED=0
# T6b: 0 = turn the Bluesky source off (quick fallback to news only); default on
BLUESKY_ENABLED=1
DETECT_WINDOW_HOURS=6
# T12c: extra SPRT alphas for the false-alarm selector (comma-separated; empty = off; 0.02 is always computed)
ALPHA_POINTS=0.005,0.01,0.05,0.1
# salt for pseudonymizing real account handles in committed files (live samples, labels)
LTR_HASH_SALT=
# "gemini" in prod, "hash" in tests (offline)
LTR_EMBEDDER=gemini
